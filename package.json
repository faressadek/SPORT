{
  "name": "sport-marketplace",
  "version": "0.4.0",
  "private": true,
  "engines": {
    "node": ">=22"
  },
  "type": "module",
  "scripts": {
    "start:api": "node apps/api/src/server.mjs",
    "start:api:db": "node --env-file=.env apps/api/src/server.mjs",
    "test:api": "node --test \"tests/api/*.test.mjs\"",
    "test:db": "node --test \"tests/db/*.test.mjs\"",
    "test": "npm run test:legacy && turbo run test",
    "dev": "turbo run dev",
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "turbo run lint",
    "test:legacy": "node --test \"tests/api/*.test.mjs\" \"tests/db/*.test.mjs\""
  },
  "dependencies": {
    "pg": "^8.23.1"
  },
  "packageManager": "pnpm@11.25.0",
  "devDependencies": {
    "@types/node": "22.20.7",
    "@types/react": "19.3.3",
    "@types/react-dom": "19.3.0",
    "eslint": "9.39.4",
    "eslint-config-next": "16.4.6",
    "prettier": "3.10.1",
    "turbo": "2.11.13",
    "typescript": "5.9.3"
  }
}
